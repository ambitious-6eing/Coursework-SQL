\f0\fs29\fsmilli14667 \'a0\'a0\'a0\'a0-- Assign the new club's code as the next sequential number
\f1\fs24 \

\f0\fs29\fsmilli14667 \'a0\'a0\'a0\'a0:NEW.clubid := max_code + 1;
\f1\fs24 \

\f0\fs29\fsmilli14667 END;
