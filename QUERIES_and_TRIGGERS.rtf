\f1\fs24 \

\f0\fs29\fsmilli14667 \'a0\'a0\'a0\'a0max_code NUMBER;
\f1\fs24 \

\f0\fs29\fsmilli14667 BEGIN
\f1\fs24 \

\f0\fs29\fsmilli14667 \'a0\'a0\'a0\'a0-- Find the highest existing code in CLUBS
\f1\fs24 \

\f0\fs29\fsmilli14667 \'a0\'a0\'a0\'a0SELECT NVL(MAX(clubid), 0) INTO max_code FROM CLUBS;
